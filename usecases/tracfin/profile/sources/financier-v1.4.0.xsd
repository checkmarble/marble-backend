			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="t_refAAV">
		<xs:sequence>
			<xs:element type="xs:positiveInteger" name="reference" minOccurs="0" maxOccurs="30"/>
			<xs:element type="t_autreRefAAV" name="autre" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="t_autreRefAAV">
		<xs:sequence>
			<xs:element type="t_string_50" name="reference" minOccurs="1"/>
			<xs:element type="t_date" name="date" minOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="t_refPPE">

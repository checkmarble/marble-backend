				</xs:annotation>
			</xs:element>
			<xs:element name="idPersonne" type="t_num_6" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Ce champ ne peut être présent qu'en l'absence des champs [autreDirigeantP] et [autreDirigeantM].
						Ce champ permet de référencer une personne déjà présente dans la déclaration.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="autreDirigeantP" type="t_autreDirigeantP" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Ce champ ne peut être présent qu'en l'absence des champs [idPersonne] et [autreDirigeantM].
						Ce champ permet de déclarer une personne non présente dans la déclaration.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="autreDirigeantM" type="t_activiteCoordonnee" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Ce champ ne peut être présent qu'en l'absence des champs [autreDirigeantP] et [idPersonne].
						Ce champ permet de déclarer une personne non présente dans la déclaration.
						Il est de même type que pour t_pm_fiche

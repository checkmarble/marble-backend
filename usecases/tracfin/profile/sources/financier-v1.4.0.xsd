			<xs:documentation>
				Nature du Soupçon d'Infraction Pénale
				Ref:liste_ref_nature_soupcon_penale.csv
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="6" />
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_natureFraudeFiscale">
		<xs:annotation>
			<xs:documentation>
				Nature du Soupçon de Fraude Fiscale
				Ref:liste_ref_nature_fraude_fiscale.csv
			</xs:documentation>

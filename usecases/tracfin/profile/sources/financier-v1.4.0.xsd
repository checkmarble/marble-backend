				elle est obligatoire si soupconElementsNonFinanciers = 0 (false)
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="dateDebut" type="t_date" minOccurs="1" />
			<xs:element name="dateFin" type="t_date" minOccurs="1" />
			<xs:element name="soupconElementsNonFinanciers" type="xs:boolean" minOccurs="1"/>
			<xs:element name="operationSuspectCSV" type="t_num_6" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="t_operationEnCours">
		<xs:annotation>
			<xs:documentation>
				Opération en cours
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="identEmetteur" type="t_string_200" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Emmetteur: Id de la personne déjà déclarée
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="refFinanciere" type="t_string_200" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Référence financière: Id de de l'équipement financier de l'émetteur déjà déclaré
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="typeOperation" type="t_typeOperation" minOccurs="0"/>
			<xs:element name="autretypeOperation" type="t_string_200" minOccurs="0" >
				<xs:annotation>
					<xs:documentation>
						Ce champ doit être rempli si le type d'opération est "Autre".
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="montantEuro" type="t_decimal_12" minOccurs="1"/>
			<xs:element name="dateLimiteExecution" type="t_date" minOccurs="1"/>
			<xs:element name="heureLimiteExecution" type="t_heure" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="t_operations">
		<xs:annotation>
			<xs:documentation>
				Détails des Opérations
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="dateDebut" type="t_date" minOccurs="1" />
			<xs:element name="dateFin" type="t_date" minOccurs="1" />
			<xs:element name="soupconElementsNonFinanciers" type="xs:boolean" minOccurs="0"/>
			<xs:element name="montantTotal" type="t_decimal_12" minOccurs="1"/>
			<xs:element name="operation" type="t_operation" minOccurs="0" maxOccurs="30"/>
			<xs:element name="operationEnCours" type="t_operationEnCours" minOccurs="0" maxOccurs="30"/>
		</xs:sequence>
	</xs:complexType>	
	<xs:complexType name="t_operationstdf">
		<xs:annotation>
			<xs:documentation>
				Détails des Opérations
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="operation" type="t_operationtdf" minOccurs="1"/>
			<xs:element name="operationEnCours" type="t_operationEnCours" minOccurs="0" maxOccurs="30"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="t_context">
		<xs:annotation>
			<xs:documentation>
				Etape 2 - Contexte et périmètre de la déclaration
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="natureSoupcon" type="t_natureSoupcon" minOccurs="1"/>
			<xs:element name="general" type="t_general" minOccurs="1"/>
			<xs:element name="information" type="t_information" minOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="t_natureSoupcon">
		<xs:sequence>
			<xs:element name="cadreLegal" type="t_cadreLegal" minOccurs="1" maxOccurs="5">
				<xs:annotation>
					<xs:documentation>
						"Cadre légale principal" doit contenir au moins une des trois valeurs suivantes :
						-  "Soupçon de financement du terrorisme (al I du L561-15)" [CL01]
						-  "Soupçon d'infraction(s) pénale(s) (al I du L561-15)"[CL02]
						-  "Soupçon de fraude(s) fiscale(s) (al II du L561-15)" [CL03]
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="natureSoupconPenale" type="t_natureSoupconPenale" minOccurs="0" maxOccurs="30">
				<xs:annotation>
					<xs:documentation>
						- Champ présent et obligatoire uniquement si le "Cadre légale principal" = [CL02]
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="autreNatureSoupconPenale" type="t_string_200" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						-  Champ présent et obligatoire uniquement si la "Nature(s) du soupçon d'infraction pénale" contient [NSP15]
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="natureFraudeFiscale" type="t_natureFraudeFiscale" minOccurs="0" maxOccurs="30">
				<xs:annotation>
					<xs:documentation>
						- Champ présent et obligatoire uniquement si le "Cadre légale principal" = [CL03]
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="autreNatureFraudeFiscale" type="t_string_200" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
						- Champ présent et obligatoire uniquement si la "Nature(s) du soupçon de fraude fiscale" contient [NFF10]
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="t_general">
		<xs:sequence>
			<xs:element name="complement" type="t_num_19" minOccurs="0" >
				<xs:annotation>
					<xs:documentation>
						- Champ présent et obligatoire uniquement dans le cas d'une déclaration complémentaire.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="refInterne" type="t_string_50" minOccurs="1"/>
			<xs:element name="aav" type="t_refAAV" minOccurs="0" />
			<xs:element name="estPrecisionSignalement" type="xs:boolean" minOccurs="1"/>
			<xs:element name="precisionSignalement" type="t_string_700" minOccurs="0"/>
			<xs:element name="estRequisitionJudiciaire" type="xs:boolean" minOccurs="1"/>
			<xs:element name="serviceEmetteur" type="t_string_200" minOccurs="0"/>
			<xs:element name="motifRequisition" type="t_string_200" minOccurs="0"/>
			<xs:element name="numeroProcedure" type="t_string_50" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="t_information">
		<xs:sequence>
			<xs:element name="gestionFortuneBanquePrivee" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Obligatoire uniquement pour les assujettis inscrits avec la profession "Banques, établissement de crédit".
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="correspondanceBancaire" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Obligatoire uniquement pour les assujettis inscrits avec la profession "Banques, établissement de crédit".
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="lienTransportDeFond" type="xs:boolean" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Indique si la déclaration est en lien avec une activité de transmission de fonds.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="activiteLPS" type="xs:boolean" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="t_declarant">
		<xs:annotation>
			<xs:documentation>
				Section : Declarant
			</xs:documentation>
		</xs:annotation>
		<xs:sequence id="t_declarant_choice">
			<xs:element name="declarant_teleDS" type="xs:boolean" minOccurs="0" />
			<xs:element name="numeroTeleDS" type="t_idTracfin" minOccurs="0" />
			<xs:element name="coordonnees" type="t_coordonnee" minOccurs="0"/>
			<xs:element name="fonction" type="t_string_50" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="t_contact">
		<xs:annotation>
			<xs:documentation>
				Autre personne à contacter pour cette déclaration
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:sequence>
				<xs:element name="coordonnees" type="t_coordonneecontact" minOccurs="1"/>
			</xs:sequence>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="t_pieceJointe">
		<xs:annotation>
			<xs:documentation>
				Section : Pièces Jointes
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="piece" minOccurs="1" maxOccurs="15">
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="t_piece_complementaire">
							<xs:attribute name="id" type="t_num_6" use="required"></xs:attribute>
						</xs:extension>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="t_personnes">
		<xs:annotation>
			<xs:documentation>
				Cette section doit contenir au moins une personne
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="pp" type="t_pp_fiche" minOccurs="0" maxOccurs="30"/>
			<xs:element name="pm" type="t_pm_fiche" minOccurs="0" maxOccurs="30"/>
			<xs:element name="pnc" type="t_pnc" minOccurs="0" maxOccurs="30"/>
		</xs:sequence>
	</xs:complexType>
	<!-- Structure du document -->
	<xs:element id="e_declaration" name="ds">
		<xs:annotation>
			<xs:documentation>
				Racine de la declaration.
				Une déclaration contient un unique noeud "ds".
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="organisme" type="t_organisme" minOccurs="1"/>
				<xs:element name="declarant" type="t_declarant" minOccurs="1"/>
				<xs:element name="contact" type="t_contact" minOccurs="0" />
				<xs:element name="context" type="t_context" minOccurs="1"/>
				<xs:element name="analyse" type="t_string_23000" minOccurs="1"/>
				<xs:element name="personnes" type="t_personnes" minOccurs="0"/>
				<xs:element name="operations" type="t_operations" minOccurs="0"/>
				<xs:element name="operationstdf" type="t_operationstdf" minOccurs="0" />
				<xs:element name="pieceJointe" type="t_pieceJointe" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>

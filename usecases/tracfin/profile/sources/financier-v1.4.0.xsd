	<xs:simpleType name="t_document">
		<xs:annotation>
			<xs:documentation>
				Code du type de pièce jointe
				Ref:liste_ref_piece_jointe.csv
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="t_string_6">
			<xs:maxLength value="6" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_registre">
		<xs:annotation>
			<xs:documentation>
				Code du type de registre / Code de type RNx sauf pour le SIREN et les choix "Je ne sais pas" et "non"
				RIDET (Registre INSEE Nouvelle Calédonie) -> [RN1]
				COM -> [RN2]
				RNA (Registre National des Associations)-> [RN3]
				RNM (Répertoire National des métiers)-> [RN4]
				LEI (Legal Entity Identifier)-> [RN5]
				étranger-> [RN6]
				autre-> [RN7]
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="SIREN" />
			<xs:enumeration value="RN1" />
			<xs:enumeration value="RN2" />
			<xs:enumeration value="RN3" />
			<xs:enumeration value="RN4" />
			<xs:enumeration value="RN5" />
			<xs:enumeration value="RN6" />
			<xs:enumeration value="RN7" />
			<xs:enumeration value="Je ne sais pas" />
			<xs:enumeration value="Non" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_typeEquipement">
		<xs:annotation>
			<xs:documentation>
				Code du type d'équipement fiancier
				Ref:liste_ref_type_equipement.csv
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="t_string_6">
			<xs:maxLength value="6" />
		</xs:restriction>
	</xs:simpleType>

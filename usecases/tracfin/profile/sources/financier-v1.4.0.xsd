<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:annotation>
		<xs:documentation>
			XSD des  déclarations de soupçons - Import unitaire - Module financier - Version 1.4.0 (2026/01/21)
		</xs:documentation>
	</xs:annotation>
	<!--Types Simples-->
	<xs:simpleType name="t_string_6">
		<xs:annotation>
			<xs:documentation>
				Chaines de caractere de taille 6
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="6" />
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_date">
		<xs:annotation>
			<xs:documentation>
				Date
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="\d{2}/\d{2}/\d{4}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_numeroIdentFiscal">
		<xs:annotation>
			<xs:documentation>
				Numéro d’identification fiscale
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="t_string_50">
			<xs:pattern value="([0-3])\d( ?)\d{2}( ?)\d{3}( ?)\d{3}( ?)\d{3}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_date_heure">
		<xs:annotation>
			<xs:documentation>
				Date + heure
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="\d{2}/\d{2}/\d{4} \d{2}:\d{2}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_heure">
		<xs:annotation>
			<xs:documentation>
				Heure
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="\d{2}:\d{2}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_contenu_fichier">
		<xs:annotation>
			<xs:documentation>
				Contenu d'une pièce jointe encodé en base 64
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="130000000"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_idTracfin">
		<xs:annotation>
			<xs:documentation>
				Identifiant TRACFIN d'un correspondant
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:positiveInteger">
			<xs:totalDigits value="6" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_num_tel">
		<xs:annotation>
			<xs:documentation>
				Type pour les champs contenant un numéro
				de téléphone ou de fax.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="25" />
			<xs:pattern value="^[+]*[(]{0,1}[0-9]{1,4}[)]{0,1}[-\s\./0-9]*$" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_mail">
		<xs:annotation>
			<xs:documentation>
				Type pour les champs contenant une adresse mail.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="200" />
			<xs:pattern value="^[\w-\._]+@([\w-]+\.)+[\w-]{2,4}$"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_string_10">
		<xs:annotation>
			<xs:documentation>Chaines de caractere de taille 10</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="10"/>
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_string_30">
		<xs:annotation>
			<xs:documentation>
				Chaines de caractere de taille 30
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="30" />
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_string_50">
		<xs:annotation>
			<xs:documentation>
				Chaines de caractere de taille 50
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="50" />
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_string_64">
		<xs:annotation>
			<xs:documentation>
				Chaines de caractere de taille 64
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="64" />
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_string_100">
		<xs:annotation>
			<xs:documentation>
				Chaines de caractere de taille 100
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="100" />
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_string_120">
		<xs:annotation>
			<xs:documentation>
				Chaines de caractere de taille 120
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="120" />
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_string_200">
		<xs:annotation>
			<xs:documentation>
				Chaines de caractere de taille 200
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="200" />
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_string_200_optional">
		<xs:annotation>
			<xs:documentation>
				Chaines de caractere de taille 200
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="200" />
			<xs:minLength value="0" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_string_255">
		<xs:annotation>
			<xs:documentation>
				Chaines de caractere de taille 255
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="255" />
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_string_255_optional">
		<xs:annotation>
			<xs:documentation>
				Chaines de caractere de taille 255
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="255" />
			<xs:minLength value="0" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_string_700">
		<xs:annotation>
			<xs:documentation>
				Chaines de caractere de taille 700
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="700" />
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_string_700_optional">
		<xs:annotation>
			<xs:documentation>
				Chaines de caractere de taille 700
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="700" />
			<xs:minLength value="0" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_string_3000">
		<xs:annotation>
			<xs:documentation>
				Chaines de caractere de taille 3000
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="3000" />
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_string_23000">
		<xs:annotation>
			<xs:documentation>
				Chaines de caractere de taille 23000
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="23000" />
			<xs:minLength value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_num_6">
		<xs:annotation>
			<xs:documentation>
				Nombre sur digits 6.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:positiveInteger">
			<xs:totalDigits value="6" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_num_19">
		<xs:annotation>
			<xs:documentation>
				Nombre sur 19 digits max.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:positiveInteger">
			<xs:totalDigits value="19" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_decimal_12">
		<xs:annotation>
			<xs:documentation>
				Nombre sur digits 12.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:decimal">
			<xs:totalDigits value="12" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_implication">
		<xs:annotation>
			<xs:documentation>
				Implication de la personne: (Personne soupçonnée / Personne impliquée) ou Victime présumée
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="t_string_64">
			<xs:enumeration value="Personne soupçonnée / Personne impliquée" />
			<xs:enumeration value="Victime présumée" />
			<xs:enumeration value="Je ne sais pas" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_natureRelation">
		<xs:annotation>
			<xs:documentation>
				Nature de la relation du déclarant avec la personne soupçonnée: Relation d'affaire / Tentative d'entrée en relation ou prospect / Client occasionnel / Aucune
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="t_string_50">
			<xs:enumeration value="Relation d'affaire" />
			<xs:enumeration value="Tentative d'entrée en relation ou prospect" />
			<xs:enumeration value="Client occasionnel" />
			<xs:enumeration value="Aucune" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_typeOperation">
		<xs:annotation>
			<xs:documentation>
				Type d'opération
				Ref: liste_ref_type_operations.csv
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="1" />
			<xs:maxLength value="100" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_choix_oui_non_nesaispas">
		<xs:annotation>
			<xs:documentation>
				Liste de choix Oui / Non / Je ne sais pas
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="t_string_50">
			<xs:enumeration value="Oui" />
			<xs:enumeration value="Non" />
			<xs:enumeration value="Je ne sais pas" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_iban">
		<xs:annotation>
			<xs:documentation>
				International Bank Account Number (IBAN)
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="t_string_50">
			<xs:pattern value="^[a-zA-Z]{2}[0-9]{2}[a-zA-Z0-9]{10,30}$"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_bic">
		<xs:annotation>
			<xs:documentation>Code BIC (SWIFT)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="11"/>
			<xs:minLength value="8" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_cib">
		<xs:annotation>
			<xs:documentation>Code CIB</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer">
			<xs:pattern value="[0-9]{5}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_numCard">
		<xs:annotation>
			<xs:documentation>Numéro de carte bancaire</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="^(?:4[0-9]{12}(?:[0-9]{3})?|[25][1-7][0-9]{14}|6(?:011|5[0-9][0-9])[0-9]{12}|3[47][0-9]{13}|3(?:0[0-5]|[68][0-9])[0-9]{11}|(?:2131|1800|35\d{3})\d{11})$"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_alphaNum">
		<xs:annotation>
			<xs:documentation>Caractères alphanumériques</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[a-zA-Z0-9 ]*"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_positiveDecimals_32">
		<xs:restriction base="xs:decimal">
			<xs:minExclusive value="0"/>
			<xs:totalDigits value="32"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- Types simples associes aux listes de reference -->
	<xs:simpleType name="t_organisme_profession">
		<xs:annotation>
			<xs:documentation>
				Code d'une profession.
				Ref: liste_ref_professions.csv
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="6" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_categorieRelation">
		<xs:annotation>
			<xs:documentation>
				Code d'une des catégories de relation.
				Ref: liste_ref_relations.csv
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="6" />
			<xs:minLength value="3" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_sousCategorieRelation">
		<xs:annotation>
			<xs:documentation>
				Code d'une des sous-catégories de relation.
				Ref: liste_ref_relations.csv
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="6" />
			<xs:minLength value="3" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_type_adresse">
		<xs:annotation>
			<xs:documentation>
				Code d'un type d'adresse.
				Ref: liste_ref_type_adresse.csv
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="6" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_type_voie">
		<xs:annotation>
			<xs:documentation>
				Code du type de voie dans une adresse.
				Ref: liste_ref_type_voie.csv
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="6" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="t_adresse_numero_voie_complement">
		<xs:annotation>
			<xs:documentation>
				Code du complément de numéro de voie
				Ref: liste_ref_complement_voie.csv
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="6" />
			<xs:enumeration value="CNV1"/>
			<xs:enumeration value="CNV2"/>
			<xs:enumeration value="CNV3"/>
			<xs:enumeration value="CNV4"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="t_autoriteDelivrance">
		<xs:simpleContent>
			<xs:extension base="t_string_255_optional">
				<xs:attribute name="newformat" type="xs:boolean" use="optional" />
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:simpleType name="t_paysType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="code"/>
			<xs:enumeration value="other"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="t_paysName">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute name="type" type="t_paysType" use="optional" />
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:complexType name="t_pays">
		<xs:annotation>
			<xs:documentation>
				Code du pays (nationalité, etc.). L'attribut type="code" est optionnel pour indiquer un code dans la balise.
				Pour mettre un autre pays, ajouter l'attribut type="other" et indiquer le pays dans la balise.
				Ref: liste_ref_pays.csv
			</xs:documentation>
		</xs:annotation>
		<xs:simpleContent>
			<xs:restriction base="t_paysName">
				<xs:minLength value="2" />
				<xs:maxLength value="200" />
			</xs:restriction>
		</xs:simpleContent>
	</xs:complexType>
	<xs:complexType name="t_pays_dromcom">
		<xs:annotation>
			<xs:documentation>
				Code du pays (nationalité, etc.).
				Ref: liste_ref_dromcom.csv et liste_ref_pays.csv
			</xs:documentation>
		</xs:annotation>
		<xs:simpleContent>
			<xs:restriction base="t_paysName">
				<xs:minLength value="2" />
				<xs:maxLength value="200" />
			</xs:restriction>
		</xs:simpleContent>
	</xs:complexType>

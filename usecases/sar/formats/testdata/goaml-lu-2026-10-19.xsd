          <xs:sequence maxOccurs="unbounded">
            <xs:element name="account_fund" type="account_fund_type" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="account_name">
        <!--removed minOccurs="0"-->
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="255" />
            <xs:minLength value="1" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="iban" type="iban_type" />
      <xs:element minOccurs="0" name="client_number">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="30" />
            <xs:minLength value="1" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:choice minOccurs="0">
        <xs:element name="personal_account_type" minOccurs="0" type="account_type">
          <xs:annotation>
            <xs:documentation>The element will be deprecated in Schema 6 and replaced by the new account_type element</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="account_type" minOccurs="0" type="account_type" goaml:supportedIn="5.1" />
      </xs:choice>
      <xs:element minOccurs="0" name="t_entity" type="t_entity_my_client" />
      <xs:element name="related_entities" minOccurs="0" goaml:supportedIn="5.1">
        <xs:complexType>
          <xs:sequence maxOccurs="unbounded">
            <xs:element name="account_related_entity" type="account_related_entity_type" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>

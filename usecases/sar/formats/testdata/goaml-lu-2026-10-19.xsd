      <xs:element name="collection_account" type="xs:boolean" fixed="1" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
      <!--added maxOccurs="0"-->
      <xs:element minOccurs="0" name="branch">
        <xs:simpleType>
          <xs:restriction base="xs:string">

          </xs:element>
          <xs:element name="report_date" type="sql_date" goaml:supportedIn="5.0" />
        </xs:choice>
        <xs:element name="currency_code_local" type="currency_type" fixed="EUR" />
        <xs:choice minOccurs="0">
          <xs:element name="reporting_person" type="t_person_registration_in_report" />
          <xs:element name="reporting_user_code" goaml:supportedIn="5.1">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:minLength value="4" />
                <xs:maxLength value="50" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:choice>
        <xs:element minOccurs="0" maxOccurs="0" name="location" type="t_address" />
        <!--added maxOccurs="0" -->
        <xs:element minOccurs="0" name="reason" type="comments_type" />
        <xs:element minOccurs="0" name="action" type="comments_type" />
        <xs:choice>
          <xs:sequence>
            <xs:sequence maxOccurs="unbounded">
              <xs:element name="transaction">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="transactionnumber">
                      <xs:simpleType>
                        <xs:annotation>
                          <xs:documentation>The transaction number length was extended to 100 chars</xs:documentation>
                        </xs:annotation>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="100" />
                          <xs:minLength value="1" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="transaction_is_suspicious" type="xs:boolean" minOccurs="0" goaml:supportedIn="5.1" />
                    <xs:element minOccurs="0" name="internal_ref_number">
                      <xs:simpleType>
                        <xs:annotation>
                          <xs:documentation>The internal ref number length was extended to 100 chars</xs:documentation>
                        </xs:annotation>
                        <xs:restriction base="xs:string">
                          <xs:minLength value="1" />
                          <xs:maxLength value="100" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="agent_name" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1">
                      <!--added maxOccurs="0"-->
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="255" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element minOccurs="0" name="transaction_location">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:minLength value="0" />
                          <xs:maxLength value="255" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="transaction_address" type="t_address" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
                    <!--added maxOccurs="0"-->
                    <xs:element minOccurs="0" name="transaction_description" type="comments_type" />
                    <xs:element name="date_transaction" type="sql_date" />
                    <xs:element minOccurs="0" name="teller">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="50" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element minOccurs="0" name="authorized">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="50" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:sequence minOccurs="0" maxOccurs="0">
                      <!--added maxOccurs="0"-->
                      <xs:element name="late_deposit">
                        <xs:complexType>
                          <xs:simpleContent>
                            <xs:extension base="xs:boolean" />
                          </xs:simpleContent>
                        </xs:complexType>
                      </xs:element>
                      <xs:element minOccurs="0" name="date_posting" type="sql_date" />
                    </xs:sequence>
                    <xs:element minOccurs="0" name="value_date" type="sql_date" />
                    <xs:element name="transaction_type_code" type="transaction_type" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
                    <!--added maxOccurs="0"-->
                    <xs:element name="transmode_code" type="conduction_type" />
                    <xs:element minOccurs="0" maxOccurs="0" name="transmode_comment">
                      <!--added maxOccurs="0"-->
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="50" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="amount_local">
                      <xs:simpleType>
                        <xs:restriction base="sql_decimal">
                          <xs:minInclusive value="0" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="transaction_status" type="transaction_status_type" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
                    <!--added maxOccurs="0"-->
                    <xs:choice>
                      <xs:element name="involved_parties">
                        <xs:complexType>
                          <xs:sequence maxOccurs="unbounded">
                            <xs:element name="party" type="t_party" />
                          </xs:sequence>
                        </xs:complexType>
                      </xs:element>
                      <xs:sequence>
                        <xs:choice>
                          <xs:element name="t_from_my_client">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="from_funds_code" type="funds_type" />
                                <xs:element minOccurs="0" maxOccurs="0" name="from_funds_comment">
                                  <!--added maxOccurs="0"-->
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="255" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element name="from_transaction_additional_info" type="transaction_additional_info_type" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
                                <!--added maxOccurs="0"-->
                                <xs:element minOccurs="0" name="from_foreign_currency" type="t_foreign_currency" />
                                <xs:sequence>
                                  <xs:element name="conductor_is_suspected" type="xs:boolean" minOccurs="0" goaml:supportedIn="5.1" />
                                  <xs:element name="t_conductor" type="t_conductor_my_client" minOccurs="0" />
                                </xs:sequence>
                                <xs:sequence>
                                  <xs:element name="from_is_suspected" type="xs:boolean" minOccurs="0" goaml:supportedIn="5.1" />
                                  <xs:choice>
                                    <xs:element name="from_account" type="t_account_my_client" />
                                    <xs:element name="from_person" type="t_person_my_client" />
                                    <xs:element name="from_entity" type="t_entity_my_client" />
                                  </xs:choice>
                                </xs:sequence>
                                <xs:element name="from_country" type="country_type" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="t_from">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="from_funds_code" type="funds_type" />
                                <xs:element minOccurs="0" maxOccurs="0" name="from_funds_comment">
                                  <!--added maxOccurs="0"-->
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="255" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element name="from_transaction_additional_info" type="transaction_additional_info_type" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
                                <!--added maxOccurs="0"-->
                                <xs:element minOccurs="0" name="from_foreign_currency" type="t_foreign_currency" />
                                <xs:sequence>
                                  <xs:element name="conductor_is_suspected" type="xs:boolean" minOccurs="0" goaml:supportedIn="5.1" />
                                  <xs:element name="t_conductor" type="t_conductor" minOccurs="0" />
                                </xs:sequence>
                                <xs:sequence>
                                  <xs:element name="from_is_suspected" type="xs:boolean" minOccurs="0" goaml:supportedIn="5.1" />
                                  <xs:choice>
                                    <xs:element name="from_account" type="t_account" />
                                    <xs:element name="from_person" type="t_person" />
                                    <xs:element name="from_entity" type="t_entity" />
                                  </xs:choice>
                                </xs:sequence>
                                <xs:element name="from_country" type="country_type" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:choice>
                        <xs:choice>
                          <xs:element name="t_to_my_client">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="to_funds_code" type="funds_type" />
                                <xs:element minOccurs="0" maxOccurs="0" name="to_funds_comment">
                                  <!--added maxOccurs="0"-->
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="255" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element name="to_transaction_additional_info" type="transaction_additional_info_type" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
                                <!--added maxOccurs="0"-->
                                <xs:element minOccurs="0" name="to_foreign_currency" type="t_foreign_currency" />
                                <xs:sequence>
                                  <xs:element name="to_is_suspected" type="xs:boolean" minOccurs="0" goaml:supportedIn="5.1" />
                                  <xs:choice>
                                    <xs:element name="to_account" type="t_account_my_client" />
                                    <xs:element name="to_person" type="t_person_my_client" />
                                    <xs:element name="to_entity" type="t_entity_my_client" />
                                  </xs:choice>
                                </xs:sequence>
                                <xs:element name="to_country" type="country_type" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="t_to">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="to_funds_code" type="funds_type" />
                                <xs:element minOccurs="0" maxOccurs="0" name="to_funds_comment">
                                  <!--added maxOccurs="0"-->
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="255" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element name="to_transaction_additional_info" type="transaction_additional_info_type" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
                                <!--added maxOccurs="0"-->
                                <xs:element minOccurs="0" name="to_foreign_currency" type="t_foreign_currency" />
                                <xs:sequence>
                                  <xs:element name="to_is_suspected" type="xs:boolean" minOccurs="0" goaml:supportedIn="5.1" />
                                  <xs:choice>
                                    <xs:element name="to_account" type="t_account" />
                                    <xs:element name="to_person" type="t_person" />
                                    <xs:element name="to_entity" type="t_entity" />
                                  </xs:choice>
                                </xs:sequence>
                                <xs:element name="to_country" type="country_type" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:choice>
                      </xs:sequence>
                    </xs:choice>
                    <xs:element minOccurs="0" name="goods_services">
                      <xs:complexType>
                        <xs:sequence maxOccurs="unbounded">
                          <xs:element name="item" type="t_trans_item" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="means_of_transport" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.2">
                      <!--added maxOccurs="0"-->
                      <xs:complexType>
                        <xs:sequence maxOccurs="unbounded">
                          <xs:element name="routing" type="route_type" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element minOccurs="0" name="comments" type="comments_type" />
                  </xs:sequence>
                  <!-- Assert added by CRF: Transfers can only be between accounts -->
                  <xs:assert test="(if (concat(t_from/from_funds_code,t_from_my_client/from_funds_code) eq 'Q') then ((t_from/from_account) or (t_from_my_client/from_account)) else true())            and (if (concat(t_to/to_funds_code,t_to_my_client/to_funds_code) eq 'Q') then ((t_to/to_account) or (t_to_my_client/to_account)) else true())" xerces:message="&lt;br/&gt;&lt;b&gt;REJ-TRS03: If the transaction type is Transfer, then both sides of the transaction must be accounts.&lt;/b&gt;&lt;br/&gt;            &lt;i&gt;REJ-TRS03: Si le type de transaction est Virement, alors les deux côtés de la transaction doivent être des comptes.&lt;/i&gt;&lt;br/&gt;            &lt;a href=&quot;https://faq.goaml.lu/asserts/&quot; target=&quot; _blank&quot;&gt;For more information, see our FAQ&lt;/a&gt;&lt;br/&gt;&lt;br/&gt;" />
                  <!-- Assert added by CRF: A transaction is the same type for 'to' and 'from' sides, funds_codes should always match -->
                  <xs:assert test="concat(t_from/from_funds_code,t_from_my_client/from_funds_code) eq concat(t_to/to_funds_code,t_to_my_client/to_funds_code)" xerces:message="&lt;br/&gt;&lt;b&gt;REJ-TRS04: Transaction type (funds_code) must be the same for 'from' and 'to' sides.&lt;/b&gt;&lt;br/&gt;            &lt;i&gt;REJ-TRS04: Le type de transaction (funds_code) doit être le même au débit qu'au crédit.&lt;/i&gt;&lt;br/&gt;            &lt;a href=&quot;https://faq.goaml.lu/asserts/&quot; target=&quot; _blank&quot;&gt;For more information, see our FAQ&lt;/a&gt;&lt;br/&gt;&lt;br/&gt;" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:element name="activity" type="activityType" minOccurs="0" goaml:supportedIn="5.0" />
          </xs:sequence>
          <xs:element name="activity" type="activityType" />
        </xs:choice>
        <xs:element minOccurs="0" name="report_indicators">
          <xs:complexType>
            <xs:sequence maxOccurs="unbounded">
              <xs:element name="indicator" type="report_indicator_type" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="additional_information" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.2">
          <!-- added maxOccurs="0" -->
          <xs:complexType>
            <xs:sequence maxOccurs="unbounded">
              <xs:element name="additional_info" type="generic_additional_info_type" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <!-- asserts added by CRF -->
      <!--	  
		Controls related to the reason field:
	-->
      <xs:assert test="if (boolean(reason)) then (reason/node() or (report_code eq 'XBD') or (report_code eq 'XBR')) else true()" xerces:message="REJ-REA01: Reason must not be empty.      REJ-REA01: Motivation ne doit pas être vide.      For more information, see our FAQ https://faq.goaml.lu/asserts/" />
      <xs:assert test="if (not(boolean(reason))) then ((report_code eq 'XBD') or (report_code eq 'XBR') or (report_code eq 'RIRA') or (report_code eq 'RIRT')) else true()" xerces:message="&lt;br/&gt;&lt;b&gt;REJ-REA02: Reason must be indicated, except if the report type is RIRA or RIRT.&lt;/b&gt;&lt;br/&gt;      &lt;i&gt;REJ-REA02: Motivation doit être renseignée, sauf si le type de déclaration est RIRA ou RIRT.&lt;/i&gt;&lt;br/&gt;      &lt;a href=&quot;https://faq.goaml.lu/asserts/&quot; target=&quot; _blank&quot;&gt;For more information, see our FAQ&lt;/a&gt;&lt;br/&gt;&lt;br/&gt;" />
      <!--
		Controls related to indicators:
	 -->
      <xs:assert test="if (not(boolean(report_indicators))) then ((report_code ne 'STR') and (report_code ne 'SAR') and (report_code ne 'STRe') and (report_code ne 'SARe') and (report_code ne 'TFTR') and (report_code ne 'TFAR')) else true()" xerces:message="&lt;br/&gt;&lt;b&gt;REJ-IND01: Indicators must be included, except if the report type is RIRA or RIRT.&lt;/b&gt;&lt;br/&gt;      &lt;i&gt;REJ-IND01: Indicateurs doivent être inclus, sauf si le type de déclaration est RIRA ou RIRT.&lt;/i&gt;&lt;br/&gt;      &lt;a href=&quot;https://faq.goaml.lu/asserts/&quot; target=&quot; _blank&quot;&gt;For more information, see our FAQ&lt;/a&gt;&lt;br/&gt;&lt;br/&gt;" />
      <!--
		Controls related to transactions:
	-->
      <xs:assert test="count(transaction/transactionnumber) eq count(distinct-values(transaction/transactionnumber))" xerces:message="&lt;br/&gt;&lt;b&gt;REJ-TRS01: Each transaction number in the report must be unique.&lt;/b&gt;&lt;br/&gt;      &lt;i&gt;REJ-TRS01: Chaque numéro de transaction dans la déclaration doit être unique.&lt;/i&gt;&lt;br/&gt;      &lt;a href=&quot;https://faq.goaml.lu/asserts/&quot; target=&quot; _blank&quot;&gt;For more information, see our FAQ&lt;/a&gt;&lt;br/&gt;&lt;br/&gt;" />
      <xs:assert test="(count(transaction) lt 501) or (report_code eq 'XBD') or (report_code eq 'XBR')" xerces:message="&lt;br/&gt;&lt;b&gt;REJ-TRS02: The limit of transactions per report is set to 500.&lt;/b&gt;&lt;br/&gt;      &lt;i&gt;REJ-TRS02: La limite de transactions par déclaration est 500.&lt;/i&gt;&lt;br/&gt;      &lt;a href=&quot;https://faq.goaml.lu/asserts/&quot; target=&quot; _blank&quot;&gt;For more information, see our FAQ&lt;/a&gt;&lt;br/&gt;&lt;br/&gt;" />
    </xs:complexType>
  </xs:element>
  <xs:complexType name="t_account_my_client">
    <xs:sequence>
      <xs:element minOccurs="0" name="institution_name">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="255" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>

<xs:schema xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xerces="http://xerces.apache.org" xmlns:goaml="http://www.unodc.org/goaml" id="report" goaml:appVersion="5.2" vc:minVersion="1.1" goaml:schemaVersion="5.0.2">
  <xs:element name="report">
    <xs:complexType>
